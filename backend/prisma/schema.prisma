generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  INSTRUCTOR
  ADMIN
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ActivityType {
  COURSE_SEARCH
  COURSE_VIEW
  LESSON_PROGRESS
  RECOMMENDATION_IMPRESSION
  RECOMMENDATION_CLICK
  RECOMMENDATION_ENROLLMENT
  RECOMMENDATION_COMPLETION
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUND_PENDING
  REFUNDED
}

enum MediaUploadStatus {
  UPLOADING
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id              String               @id @default(uuid()) @db.Uuid
  email           String               @unique
  name            String
  passwordHash    String
  role            UserRole             @default(STUDENT)
  lastSeenAt      DateTime?            @db.Timestamptz(3)
  createdAt       DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime             @updatedAt @db.Timestamptz(3)
  courses         Course[]
  enrollments     Enrollment[]
  payments        Payment[]
  progress        LearningProgress[]
  activities      ActivityEvent[]
  mediaAssets     MediaAsset[]
  mediaUploads    MediaUploadSession[]
  courseReviews   CourseReview[]
  courseMaterials CourseMaterial[]

  @@index([lastSeenAt])
}

model Course {
  id           String               @id @default(uuid()) @db.Uuid
  title        String
  slug         String               @unique
  description  String               @db.Text
  category     String               @default("Chưa phân loại")
  level        String               @default("Mọi cấp độ")
  tags         String[]             @default([])
  price        Decimal              @default(0) @db.Decimal(10, 2)
  status       CourseStatus         @default(DRAFT)
  deletedAt    DateTime?            @db.Timestamptz(3)
  thumbnail    String?
  instructorId String               @db.Uuid
  instructor   User                 @relation(fields: [instructorId], references: [id], onDelete: Restrict)
  sections     CourseSection[]
  quizzes      CourseQuiz[]
  enrollments  Enrollment[]
  payments     Payment[]
  activities   ActivityEvent[]
  mediaAssets  MediaAsset[]
  mediaUploads MediaUploadSession[]
  reviews      CourseReview[]
  materials    CourseMaterial[]
  createdAt    DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime             @updatedAt @db.Timestamptz(3)

  @@index([status, createdAt])
  @@index([status, deletedAt, createdAt])
  @@index([instructorId])
}

model CourseSection {
  id        String         @id @default(uuid()) @db.Uuid
  title     String
  position  Int            @default(0)
  courseId  String         @db.Uuid
  course    Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons   CourseLesson[]
  createdAt DateTime       @default(now()) @db.Timestamptz(3)

  @@unique([courseId, position])
}

model CourseLesson {
  id          String             @id @default(uuid()) @db.Uuid
  title       String
  description String?            @db.Text
  position    Int                @default(0)
  durationSec Int                @default(0)
  videoUrl    String?
  sectionId   String             @db.Uuid
  section     CourseSection      @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  progress    LearningProgress[]
  createdAt   DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime           @updatedAt @db.Timestamptz(3)

  @@unique([sectionId, position])
}

model CourseQuiz {
  id          String               @id @default(uuid()) @db.Uuid
  title       String
  description String?              @db.Text
  courseId    String               @db.Uuid
  course      Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  questions   CourseQuizQuestion[]
  createdAt   DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime             @updatedAt @db.Timestamptz(3)

  @@index([courseId, createdAt])
}

model CourseQuizQuestion {
  id            String     @id @default(uuid()) @db.Uuid
  prompt        String     @db.Text
  options       String[]
  correctOption Int
  position      Int        @default(0)
  quizId        String     @db.Uuid
  quiz          CourseQuiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
  createdAt     DateTime   @default(now()) @db.Timestamptz(3)

  @@unique([quizId, position])
}

model Enrollment {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @db.Uuid
  courseId        String    @db.Uuid
  paymentId       String?   @unique @db.Uuid
  enrolledAt      DateTime  @default(now()) @db.Timestamptz(3)
  refundExpiresAt DateTime? @db.Timestamptz(3)
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  course          Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  payment         Payment?  @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@unique([userId, courseId])
  @@index([userId, enrolledAt])
}

model CourseReview {
  id        String   @id @default(uuid()) @db.Uuid
  rating    Int
  comment   String   @db.Text
  userId    String   @db.Uuid
  courseId  String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([courseId, createdAt])
}

model CourseMaterial {
  id           String   @id @default(uuid()) @db.Uuid
  originalName String
  storageKey   String   @unique
  sizeBytes    Int
  courseId     String   @db.Uuid
  uploadedById String   @db.Uuid
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  course       Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  uploadedBy   User     @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([courseId, createdAt])
}

model Payment {
  id                 String        @id @default(uuid()) @db.Uuid
  transactionRef     String        @unique
  amount             Decimal       @db.Decimal(10, 2)
  status             PaymentStatus @default(PENDING)
  responseCode       String?
  bankCode           String?
  transactionNo      String?
  vnpCreateDate      String?
  payDate            String?
  paidAt             DateTime?     @db.Timestamptz(3)
  refundRequestId    String?
  refundResponseCode String?
  refundedAt         DateTime?     @db.Timestamptz(3)
  createdAt          DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime      @updatedAt @db.Timestamptz(3)
  userId             String        @db.Uuid
  courseId           String        @db.Uuid
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  course             Course        @relation(fields: [courseId], references: [id], onDelete: Restrict)
  enrollment         Enrollment?

  @@index([userId, createdAt])
  @@index([courseId, status])
}

model LearningProgress {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @db.Uuid
  lessonId       String       @db.Uuid
  positionSec    Int          @default(0)
  watchedSeconds Int          @default(0)
  completedAt    DateTime?    @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson         CourseLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId, updatedAt])
}

model ActivityEvent {
  id          String       @id @default(uuid()) @db.Uuid
  userId      String       @db.Uuid
  courseId    String?      @db.Uuid
  type        ActivityType
  searchQuery String?
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  course      Course?      @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([type, createdAt])
}

model MediaAsset {
  id           String   @id @default(uuid()) @db.Uuid
  originalName String
  storageKey   String   @unique
  mimeType     String
  sizeBytes    Int
  courseId     String?  @db.Uuid
  uploadedById String   @db.Uuid
  course       Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)
  uploadedBy   User     @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  @@index([courseId])
}

model MediaUploadSession {
  id                  String            @id @default(uuid()) @db.Uuid
  storageKey          String            @unique
  multipartUploadId   String
  originalName        String
  mimeType            String
  sizeBytes           BigInt
  partSizeBytes       Int
  courseId            String            @db.Uuid
  uploadedById        String            @db.Uuid
  expiresAt           DateTime          @db.Timestamptz(3)
  completedAt         DateTime?         @db.Timestamptz(3)
  status              MediaUploadStatus @default(UPLOADING)
  processingStartedAt DateTime?         @db.Timestamptz(3)
  processingError     String?           @db.Text
  assetIds            String[]          @default([])
  createdAt           DateTime          @default(now()) @db.Timestamptz(3)
  course              Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  uploadedBy          User              @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([uploadedById, createdAt])
}
